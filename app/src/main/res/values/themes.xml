<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Bewusst ein festes helles Farbschema statt DayNight: die Zielgruppe
        bedient die App überwiegend blind oder mit stark eingeschränktem
        Sehvermögen, und ein vorhersagbarer, geprüfter Kontrast ist mehr wert
        als ein mitwachsendes Theme. Aus demselben Grund sind alle Rollen
        ausdrücklich gesetzt - sonst füllt Material3 die nicht gesetzten mit
        seiner violetten Grundpalette auf, was neben dem DialOS-Blau falsch
        aussieht und den Kontrast schwächt.
    -->
    <style name="Theme.DialOsMobil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dialos_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dialos_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/dialos_blue_dark</item>

        <item name="colorSecondary">@color/dialos_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/dialos_green_container</item>
        <item name="colorOnSecondaryContainer">@color/dialos_green_dark</item>

        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>

        <item name="android:statusBarColor">@color/dialos_blue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        Kontraststarke Fassung, umschaltbar über den Knopf oben rechts.
        Schwarzer Grund mit gelben Schaltflächen ist das Schema, das bei
        starker Sehbehinderung am zuverlässigsten funktioniert: Gelb auf
        Schwarz bleibt auch bei Blendung, Grauem Star und Kontrastverlust
        lesbar, wo Blau auf Weiß verschwimmt.
    -->
    <style name="Theme.DialOsMobil.HighContrast" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/hc_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/hc_yellow</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/hc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/hc_yellow</item>
        <item name="colorOutline">@color/hc_yellow</item>
        <item name="colorOutlineVariant">@color/hc_yellow</item>
        <item name="android:textColorSecondary">@color/hc_muted</item>

        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Große, kontrastreiche Schaltflächen: die App wird überwiegend blind
         oder mit stark eingeschränkter Motorik bedient. -->
    <style name="Widget.DialOsMobil.BigButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">192dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
