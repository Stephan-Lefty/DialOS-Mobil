<?xml version="1.0" encoding="utf-8"?>
<!--
    Vier Zellen breit, zwei hoch - auf praktisch jedem Startbildschirm die
    volle Breite. minWidth/minHeight gelten für ältere Android-Fassungen,
    targetCellWidth/Height ab Android 12.

    resizeMode="horizontal|vertical" lässt den Nutzer es größer ziehen,
    aber minResizeWidth verhindert, dass es kleiner als drei Zellen wird -
    darunter wäre es für die Zielgruppe nicht mehr sicher zu treffen.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_voice"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_voice"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
