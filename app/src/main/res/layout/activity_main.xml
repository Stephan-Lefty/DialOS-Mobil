<?xml version="1.0" encoding="utf-8"?>
<!--
    Der Startbildschirm zeigt nur, was täglich gebraucht wird: Lautstärke,
    Kontrast, den Zustand und den einen großen Knopf. Alles zur Einrichtung
    liegt hinter "Infos & Einstellungen" unten - das braucht man einmal.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- fitsSystemWindows ueberschreibt das Padding der View, auf der es
         steht. Der eigene Rand muss deshalb eine Ebene tiefer liegen,
         sonst kleben die Schaltflaechen am Bildschirmrand.

         Der ScrollView mit fillViewport haelt den Aufbau auch auf kleinen
         Bildschirmen erreichbar: passt alles, verteilt der Space unten den
         Rest wie bisher; passt es nicht, laesst es sich scrollen, statt
         den grossen Knopf abzuschneiden. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:orientation="vertical"
        android:padding="20dp">

    <!-- Kopfzeile: links Lautstärke, rechts Kontrast. Beides muss ohne
         Umweg über die Einstellungen erreichbar sein - wer schlecht sieht
         oder hört, braucht es sofort. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolume"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minHeight="64dp"
            android:textSize="17sp"
            android:text="@string/volume_normal"
            app:icon="@drawable/ic_volume"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContrast"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:textSize="17sp"
            android:text="@string/contrast_on"
            app:icon="@drawable/ic_contrast"
            app:iconGravity="textStart" />
    </LinearLayout>

    <ImageView
        android:id="@+id/logo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher_foreground" />

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/headline"
        android:textSize="28sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/subline"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:minHeight="72dp"
        android:padding="16dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/status_off"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Der eine Knopf, der zählt: doppelt so hoch wie eine übliche
         Schaltfläche, damit er auch mit zitternden Händen oder ohne
         hinzusehen zuverlässig getroffen wird. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        style="@style/Widget.DialOsMobil.BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_start"
        app:icon="@drawable/ic_mic"
        app:iconGravity="textStart"
        app:iconSize="36dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInfo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="52dp"
        android:text="@string/info_title"
        android:textSize="16sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
