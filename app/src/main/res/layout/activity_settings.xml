<?xml version="1.0" encoding="utf-8"?>
<!--
    Alles, was zur Einrichtung gehört: Berechtigungen, Dauerbetrieb,
    Schalter und die Kurzanleitung. Bewusst von der Startseite getrennt -
    dort stört es täglich, hier wird es einmal gebraucht.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="72dp"
            android:text="@string/back"
            android:textSize="19sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:accessibilityHeading="true"
            android:text="@string/info_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/perm_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/perm_needed"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermissions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/perm_grant"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/battery_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/battery_body"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:text="@string/battery_button"
            android:textSize="17sp" />

        <!--
            Beantwortet die Frage "beendet sich die App immer wieder?" ohne
            Kabel und ohne Play Console - sie kam aus dem geschlossenen Test
            und war sonst nicht zu klären.
        -->
        <TextView
            android:id="@+id/interruptionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:textSize="16sp"
            tools:text="Vom Telefon unterbrochen: 3 mal, zuletzt am 6.9.2026, 14:20." />

        <!--
            Der Balken lässt sich sonst nur über langes Drücken, Blättern,
            Ziehen und Loslassen platzieren - für die Zielgruppe praktisch
            unbenutzbar. Ausgeblendet, sobald er liegt oder der Launcher das
            Anfragen nicht unterstützt.
        -->
        <TextView
            android:id="@+id/widgetHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="false"
            android:text="@string/widget_add_body"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWidget"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/widget_add_button"
            android:textSize="17sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHotword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/setting_hotword"
            android:textSize="17sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/setting_confirm"
            android:textSize="17sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/setting_autostart"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/voice_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_body"
            android:textSize="16sp" />

        <!--
            Knöpfe zum Weiterschalten statt Schieberegler oder Auswahlliste:
            Ein Regler ist ohne Sicht und mit zittrigen Händen kaum zu treffen.
            Nach jedem Tippen kommt eine Hörprobe - sonst lässt sich eine
            Stimme nicht beurteilen.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeechRate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            tools:text="Tempo: Normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoice"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:textSize="17sp"
            tools:text="Stimme: 1 von 3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/help_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/help_body"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackBottom"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:minHeight="72dp"
            android:text="@string/back"
            android:textSize="19sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/versionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:minHeight="52dp"
            android:paddingStart="0dp"
            android:text="@string/repo_link"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
