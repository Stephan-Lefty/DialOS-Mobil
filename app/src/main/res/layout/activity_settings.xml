<?xml version="1.0" encoding="utf-8"?>
<!--
    Alles, was zur Einrichtung gehört: Berechtigungen, Dauerbetrieb,
    Schalter und die Kurzanleitung. Bewusst von der Startseite getrennt -
    dort stört es täglich, hier wird es einmal gebraucht.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="72dp"
            android:text="@string/back"
            android:textSize="19sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:accessibilityHeading="true"
            android:text="@string/info_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/perm_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/perm_needed"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermissions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/perm_grant"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/battery_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/battery_body"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/battery_button"
            android:textSize="17sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHotword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/setting_hotword"
            android:textSize="17sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/setting_confirm"
            android:textSize="17sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="60dp"
            android:text="@string/setting_autostart"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/help_title"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/help_body"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackBottom"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:minHeight="72dp"
            android:text="@string/back"
            android:textSize="19sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/versionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:minHeight="52dp"
            android:paddingStart="0dp"
            android:text="@string/repo_link"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
